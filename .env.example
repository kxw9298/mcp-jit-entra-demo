# From the Entra app registration "mcp-jit-demo" (Overview page)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Defaults to api://<ENTRA_CLIENT_ID>
#ENTRA_APP_ID_URI=

# Where the server is reachable from your browser and Claude Code
PUBLIC_BASE_URL=http://localhost:8000

# Signs the approval-page session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=change-me

LOG_LEVEL=INFO
